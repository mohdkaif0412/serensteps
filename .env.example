# ─────────────────────────────────────────────────────────────────
# Serene Step — environment variables
# Copy this file to `.env` and fill in the values.
#
# Note: the brand's display name is "Serene Step" (singular, matching the
# logo) while the domain and mailbox stay serenesteps.net. That's deliberate.
# ─────────────────────────────────────────────────────────────────

# ── Site URL (canonical domain) ───────────────────────────────────
# The base URL used for canonical tags, sitemap.xml, robots.txt and
# JSON-LD. Set this to your live domain in production; on a Vercel
# preview you can set it to the preview URL. No trailing slash.
# Defaults to https://serenesteps.net if left unset.
NEXT_PUBLIC_SITE_URL="https://serenesteps.net"

# ── Public contact email ──────────────────────────────────────────
# Shown in the footer, contact page, and legal pages. Defaults to
# steps@serenesteps.net if left unset.
NEXT_PUBLIC_CONTACT_EMAIL="steps@serenesteps.net"

# ── Phone / WhatsApp ──────────────────────────────────────────────
# The local number, digits only (no spaces, no leading zero) — this is
# what's printed on the page. Defaults to 7006788155.
NEXT_PUBLIC_CONTACT_PHONE="7006788155"
# Dialling code, digits only, no "+". Used to build the tel: and
# wa.me click-to-chat links. Defaults to 91 (India) — change if wrong.
NEXT_PUBLIC_PHONE_COUNTRY="91"

# ── Social links (optional) ───────────────────────────────────────
# Paste the full profile URL to show the icon in the footer and the
# contact page. Leave a line blank (or unset) and that icon simply
# won't appear — no dead links.
# e.g. NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourhandle"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# ── Practitioner (for Person / author schema) ─────────────────────
# Naming a real, credentialed expert is the strongest trust signal a
# health site has, and both Google and the answer engines reward it.
# Leave NEXT_PUBLIC_PRACTITIONER_NAME blank and every Person-shaped
# signal is omitted rather than guessed: no Person JSON-LD, no article
# byline, and posts are authored by the practice itself.
NEXT_PUBLIC_PRACTITIONER_NAME=""
NEXT_PUBLIC_PRACTITIONER_TITLE="Counselling Psychologist"
# Comma-separated, e.g. "M.Phil Clinical Psychology, RCI-registered"
NEXT_PUBLIC_PRACTITIONER_CREDENTIALS=""

# ── Location & local SEO (optional) ───────────────────────────────
# Set NEXT_PUBLIC_SERVICE_AREA to the city or region the practice
# serves ("Srinagar, Jammu & Kashmir") and the location flows into the
# site description, the home-page title, keywords and JSON-LD at once.
# Leave blank for a deliberately reach-neutral, online-first site.
NEXT_PUBLIC_SERVICE_AREA=""
#
# A postal address is only published once the LOCALITY is set — a
# half-filled address is worse for local search than none. Fill these in
# for a physical practice, and keep them identical to your Google
# Business Profile listing.
NEXT_PUBLIC_ADDRESS_STREET=""
NEXT_PUBLIC_ADDRESS_LOCALITY=""
NEXT_PUBLIC_ADDRESS_REGION=""
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=""
# ISO 3166-1 alpha-2 country code. Defaults to IN.
NEXT_PUBLIC_ADDRESS_COUNTRY="IN"
# Decimal degrees, for the `geo` property in JSON-LD.
NEXT_PUBLIC_GEO_LAT=""
NEXT_PUBLIC_GEO_LNG=""
# A Google Maps / Apple Maps link for the "View map" footer link.
NEXT_PUBLIC_MAP_URL=""
# Opening hours as "Day-Day HH:MM-HH:MM" entries, comma-separated.
# e.g. "Mo-Fr 10:00-18:00, Sa 10:00-14:00"
NEXT_PUBLIC_OPENING_HOURS=""
# Schema.org priceRange, e.g. "₹₹" or "₹500-₹2000". Omitted when blank.
NEXT_PUBLIC_PRICE_RANGE=""

# ── Search Console / Bing verification (optional) ─────────────────
# The token from the "HTML tag" verification method — just the content
# value, not the whole <meta> tag. Server-only, so no NEXT_PUBLIC_.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ── Analytics (optional, privacy-friendly) ────────────────────────
# Set the domain to switch on cookieless Plausible analytics; leave it
# blank and no third-party script is loaded at all. Point
# NEXT_PUBLIC_PLAUSIBLE_SRC at your own instance to self-host (an Umami
# script URL works too).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC=""

# ── Content freshness (optional) ──────────────────────────────────
# An ISO date used as `lastModified` for the hand-written pages in
# sitemap.xml and as the "Last updated" line in llms.txt /
# llms-full.txt. In CI, set it to the release commit date. Falls back to
# the deploy time.
SITE_LAST_MODIFIED=""

# ── Database ──────────────────────────────────────────────────────
# Postgres, shared by local dev and production (see prisma/schema.prisma).
# Neon: DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Docker Compose sets this for you (see docker-compose.yml).
DATABASE_URL="postgresql://serene:serene@localhost:5432/serenesteps?schema=public"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────
# A long random secret. Generate one with:  npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# ── Seed admin account ────────────────────────────────────────────
# Used by `npm run db:seed` to create the single admin login.
ADMIN_EMAIL="admin@serenesteps.net"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_NAME="Serene Step Admin"

# ── Booking calendar (optional) ───────────────────────────────────
# Connect a real calendar and the contact page shows a live inline
# booking widget; every "Book" button then reads "Book Now" and jumps
# to it. Leave BOTH blank and the site instead reads "Request a
# session" and routes people to the contact form (no dead ends).
#
# How to connect (pick ONE):
#   • Cal.com  — copy your "username/event-type" from your Cal.com
#                event link (e.g. cal.com/serene-steps/intro-call →
#                "serene-steps/intro-call") into NEXT_PUBLIC_CALCOM_LINK.
#   • Calendly — paste your full event URL into NEXT_PUBLIC_CALENDLY_URL
#                (e.g. https://calendly.com/serene-steps/intro-call).
# If both are set, Cal.com is used.
# NEXT_PUBLIC_CALCOM_LINK="serene-steps/intro-call"
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/serene-steps/intro-call"

# ── Cloudinary — admin image uploads (optional) ───────────────────
# Leave blank to fall back to pasting image URLs in the admin.
# Create an UNSIGNED upload preset in your Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Resend — contact-form email notifications (optional) ──────────
# Leave RESEND_API_KEY blank to skip emails (submissions are still saved
# and visible in the admin). For production, verify a domain in Resend
# and set CONTACT_FROM to an address on that domain.
RESEND_API_KEY=""
CONTACT_NOTIFY_TO="steps@serenesteps.net"
CONTACT_FROM="Serene Step <onboarding@resend.dev>"
